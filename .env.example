NODE_ENV=production
PORT=3000
APP_JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=

# Firebase Admin credentials. Prefer the base64 JSON form in hosted environments.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=

# Public Firebase browser config served at /config.js.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Optional first-run fallback for Sr. DC login if meta/config.srPin is not set.
SR_ADMIN_PIN=
